{
  "name": "@pg/db",
  "version": "0.1.0",
  "private": true,
  "description": "Single owner of the PropertiGuru Next database: migrations, seeds and the RLS test suite.",
  "type": "module",
  "scripts": {
    "migrate": "node scripts/db-migrate.mjs",
    "migrate:staging": "node scripts/db-migrate.mjs --env=staging",
    "status": "node scripts/db-migrate.mjs --status",
    "status:staging": "node scripts/db-migrate.mjs --status --env=staging",
    "dry-run": "node scripts/db-dry-run.mjs",
    "dry-run:staging": "node scripts/db-dry-run.mjs --env=staging",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test": "vitest run tests",
    "ghl-drain": "node scripts/ghl-drain.mjs",
    "ghl-drain:staging": "node scripts/ghl-drain.mjs --env=staging"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "vitest": "^4.1.10"
  }
}
