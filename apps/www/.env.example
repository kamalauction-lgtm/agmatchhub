# --- Marketplace (apps/www) ---
# SUPABASE_SERVICE_ROLE_KEY MUST NOT APPEAR IN THIS FILE OR THIS ENVIRONMENT.
# The public app reads only the public_* views with the anon key. See
# src/lib/supabase/public.ts, which fails the build if a privileged key is set.

NEXT_PUBLIC_APP_URL=http://localhost:8152
NEXT_PUBLIC_HUB_URL=https://hub.propertiguru.id

NEXT_PUBLIC_APP_NAME="PropertiGuru"
NEXT_PUBLIC_APP_SHORT_NAME="PropertiGuru"
# Set to "true" only once the brand has passed trademark clearance (risk R1).
NEXT_PUBLIC_BRAND_FINAL=false

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
