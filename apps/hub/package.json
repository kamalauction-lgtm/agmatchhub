{
  "name": "@pg/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Agent operating system + MatchHub co-broke platform (hub.propertiguru.id)",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy": "node -e \"for (const d of ['.open-next','.next']) fs.rmSync(d,{recursive:true,force:true})\" && opennextjs-cloudflare build && node ../../scripts/verify-build-target.mjs && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "dev:staging": "node scripts/dev-staging.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@pg/ai": "*",
