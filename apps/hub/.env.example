# --- App URLs (no hard-coded domains anywhere in code; final domain TBD) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
REQUEST_LINK_BASE_URL=http://localhost:3000/r
CLIENT_PRESENTATION_BASE_URL=http://localhost:3000/p

# --- Brand fallbacks (DB brand_settings overrides win at runtime) ---
NEXT_PUBLIC_APP_NAME="IQI AG Agent Platform"
NEXT_PUBLIC_APP_SHORT_NAME="Agent Platform"
NEXT_PUBLIC_APP_TAGLINE="One platform for your whole property business."

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# 32+ random bytes, base64. Signs client-presentation session cookies.
TOKEN_SIGNING_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare (CI/deploy only) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Email ---
# Verified Resend sender. Must be on a domain verified in Resend.
EMAIL_FROM="IQI AG MatchHub <noreply@propertiguru.id>"

# Where shared listing links point (the public marketplace).
NEXT_PUBLIC_MARKETPLACE_URL=https://www.propertiguru.id

# --- Content Studio: direct social publishing (optional) ---
# From a Meta developer app (developers.facebook.com) with Facebook Login for
# Business; needs App Review for pages_manage_posts + instagram_content_publish.
# Absent = the connect page explains itself and share buttons still work.
META_APP_ID=
META_APP_SECRET=
# Shared secret the cron caller sends as x-cron-secret to /api/social/publish-due.
SOCIAL_CRON_SECRET=

# AI providers (Decision 1, 7 Nov 2026: reuse existing keys; production values are Worker secrets)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret the Cron Trigger presents to /api/cron (falls back to SOCIAL_CRON_SECRET)
CRON_SECRET=
# Hero partner API key, scope rens:status (E8)
HERO_API_KEY=
# Hero partner API base (default: https://m4u-api.iqiaggroup.workers.dev)
HERO_API_BASE=

# Server-to-server listing ingest (Hero -> hub). Per-country ingest agent is set on /admin/countries;
# LISTING_INGEST_AGENT_ID is the legacy Indonesian fallback.
LISTING_INGEST_SECRET=
LISTING_INGEST_AGENT_ID=

# --- Payments (Decision 8, E11). Production values are Worker secrets. ---
# The provider's MODE (off / sandbox / live) is a row on /admin/payments, not an env.
# Sandbox keys here never reach the live hosts: the adapter refuses a key whose
# shape contradicts the mode (sk_test_ vs sk_live_, SB-Mid-server- vs Mid-server-).
# Webhook URLs to register at each dashboard: <APP_BASE_URL>/api/payments/webhook/{billplz|midtrans|stripe}
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
MIDTRANS_SERVER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Decision 8, E12). Production values are Worker secrets. ---
# One system-user token serves every number in the WhatsApp Business Account; the
# phone_number_id per country is a row on /admin/whatsapp. Webhook to register in the
# Meta app (field "messages"): <APP_BASE_URL>/api/whatsapp/webhook with WHATSAPP_VERIFY_TOKEN.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Graph API version (default v21.0)
WHATSAPP_GRAPH_VERSION=
